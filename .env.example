# Server/worker only. Copy this file to .env; never commit real credentials.
# Use a user token scoped to an organization you control, or the explicit GitHub CLI option.
GITHUB_ACCESS_TOKEN=
GITHUB_ORGANIZATION=
GITHUB_TEST_USERNAME=

# Comma-separated stable numeric GitHub user IDs for other protected identities.
GITHUB_PROTECTED_USER_IDS=

# Supabase: secret key and connection URL stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
OFFBOARD_ADMIN_EMAIL=
OFFBOARD_APP_URL=http://127.0.0.1:3000
OFFBOARD_WORKER_TOKEN=

# Only explicitly authorized, disposable non-privileged test identities may be removed.
GITHUB_REMOVAL_TEST_USER_IDS=

# Outbound approval email; sender must belong to a verified Resend domain.
RESEND_API_KEY=
APPROVAL_EMAIL_FROM="Offboard <notifications@paayee.org>"

# Restricted Switch adapter. Separate from the worker token; never expose to agent text.
OFFBOARD_SWITCH_TOKEN=
OFFBOARD_SWITCH_ROOM_ID=
OFFBOARD_SWITCH_AGENT_ID=
OFFBOARD_SWITCH_SENDER_ID=
OFFBOARD_SWITCH_CASE_IDS=
OFFBOARD_SWITCH_INTEGRATION_ID=
